<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ case.reference }} — {{ 'Executive' if kind == 'executive' else 'Technical' }} investigation report</title>
<style>
  @page { size: A4; margin: 22mm 18mm 20mm 18mm; @bottom-center { content: "Veylith · " counter(page) " / " counter(pages); font-size: 8pt; color: #666; } }
  body { font-family: "DejaVu Sans", Arial, sans-serif; font-size: 10pt; color: #1b1f24; line-height: 1.45; }
  h1 { font-size: 22pt; margin: 0 0 4pt; }
  h2 { font-size: 13pt; border-bottom: 1px solid #c9d1d9; padding-bottom: 3pt; margin-top: 18pt; page-break-after: avoid; }
  h3 { font-size: 11pt; margin: 10pt 0 3pt; }
  .cover { padding: 40mm 0 20mm; page-break-after: always; }
  .muted { color: #57606a; }
  .banner { border: 1px solid #d4a72c; background: #fff8c5; padding: 6pt 8pt; margin: 10pt 0; }
  .note { border-left: 3px solid #8c959f; padding: 2pt 8pt; margin: 6pt 0; background: #f6f8fa; }
  table { width: 100%; border-collapse: collapse; margin: 6pt 0; }
  th, td { border: 1px solid #d0d7de; padding: 3pt 5pt; text-align: left; vertical-align: top; font-size: 9pt; }
  th { background: #f6f8fa; }
  .tag { display: inline-block; padding: 0 5pt; border: 1px solid #8c959f; border-radius: 8pt; font-size: 8pt; }
  .block { page-break-inside: avoid; margin-bottom: 8pt; }
  ul { margin: 3pt 0 3pt 14pt; padding: 0; }
  code { font-family: "DejaVu Sans Mono", monospace; font-size: 8pt; word-break: break-all; }
</style>
</head>
<body>
<section class="cover">
  <div class="muted">VEYLITH · THIRD-PARTY INCIDENT IMPACT REPORT</div>
  <div class="tag">CONFIDENTIAL — for the named client and authorised personnel only</div>
  <h1>{{ case.title }}</h1>
  <p>{{ 'Executive summary report' if kind == 'executive' else 'Technical investigation report' }}</p>
  <table>
    <tr><th>Report ID</th><td>{{ reference }}</td></tr>
    <tr><th>Case</th><td>{{ case.reference }} · {{ case.status }} · severity {{ case.severity }} · priority {{ case.priority }}</td></tr>
    <tr><th>Client</th><td>{{ client }}</td></tr>
    <tr><th>Prepared by</th><td>{{ organization }} (generated by {{ generated_by }})</td></tr>
    <tr><th>Generated</th><td>{{ generated_at.strftime('%Y-%m-%d %H:%M UTC') }} · template v{{ template_version }}</td></tr>
  </table>
  {% if has_synthetic %}
  <div class="banner"><strong>Synthetic demonstration data.</strong> Some or all findings in this report come from synthetic demo records and are not real intelligence about any real organization.</div>
  {% endif %}
</section>

<h2>1. Executive summary</h2>
<p>
  {% if assessments %}
  This investigation covers {{ assessments|length }} assessment(s) for <strong>{{ client }}</strong>.
  {{ confirmed|length }} {{ 'is' if confirmed|length == 1 else 'are' }} supported by verified findings;
  {{ potential|length }} {{ 'remains' if potential|length == 1 else 'remain' }} <em>potential impact or insufficient data</em>,
  meaning a product or dependency match exists but exposure or compromise has <strong>not</strong> been established.
  {% else %}
  No impact assessments are linked to this case.
  {% endif %}
  Remediation: {{ tasks_done }} of {{ tasks|length }} task(s) completed, {{ tasks_verified }} verified{% if tasks_open %}, {{ tasks_open }} outstanding{% endif %}.
  {% if tasks_unverified_done %}{{ tasks_unverified_done }} completed task(s) have <strong>not</strong> been independently verified; completion is the doer's claim.{% endif %}
  {% if case.status in ('resolved', 'closed') %}Case status: {{ case.status }}.{% endif %}
</p>
{% if case.resolution_summary %}<div class="note"><strong>Resolution summary.</strong> {{ case.resolution_summary }}</div>{% endif %}
{% if case.description %}<p>{{ case.description }}</p>{% endif %}

<h2>2. Incident or advisory background</h2>
{% if advisory %}
<p><strong>{{ advisory.id }}</strong> — {{ advisory.title }}<br>
<span class="muted">Severity: {{ advisory.severity }}{% if advisory.published_at %} · Published {{ advisory.published_at.strftime('%Y-%m-%d') }}{% endif %}</span></p>
{% if advisory.description %}<p>{{ advisory.description }}</p>{% endif %}
{% if advisory.url %}<p class="muted">Source: <code>{{ advisory.url }}</code></p>{% endif %}
{% else %}<p class="muted">No advisory is linked to this case.</p>{% endif %}

<h2>3. Affected products, vendors and assets</h2>
{% if assessments %}
<table>
  <tr><th>Advisory</th><th>Vendor / product</th><th>Assessment state</th><th>Priority</th></tr>
  {% for a in assessments %}
  <tr><td>{{ a.advisory }}</td><td>{{ a.vendor }} — {{ a.product }}</td><td>{{ a.state_label }}</td><td>{{ a.priority }}</td></tr>
  {% endfor %}
</table>
{% if assets %}
<h3>Linked client assets</h3>
<ul>{% for a in assets %}<li>{{ a.label }}{% if a.criticality %} — {{ a.criticality }} criticality{% endif %}</li>{% endfor %}</ul>
{% endif %}
{% else %}<p class="muted">None.</p>{% endif %}

{% if kind == 'technical' %}
<h2>4. Impact paths</h2>
{% for a in assessments %}
<div class="block">
  <h3>{{ a.advisory }} → {{ a.vendor }} {{ a.product }}</h3>
  <ol>{% for step in a.path %}<li>{{ step.label }}{% if step.match %} <span class="muted">(match: {{ step.match }}, version: {{ step.version_status }})</span>{% endif %}</li>{% endfor %}</ol>
</div>
{% else %}<p class="muted">No impact paths recorded.</p>{% endfor %}

<h2>5. Evidence, sources and assessment rationale</h2>
{% for a in assessments %}
<div class="block">
  <h3>{{ a.advisory }} — {{ a.state_label }}</h3>
  <p class="muted">Source: {{ a.source }}{% if a.source_url %} · <code>{{ a.source_url }}</code>{% endif %}</p>
  {% if a.synthetic %}<div class="banner">Synthetic demonstration advisory.</div>{% endif %}
  <table>
    <tr>{% for name, level in a.confidence.items() %}<th>{{ name }} confidence</th>{% endfor %}</tr>
    <tr>{% for name, level in a.confidence.items() %}<td>{{ level }}</td>{% endfor %}</tr>
  </table>
  <strong>Prioritisation factors</strong>
  <table>
    <tr><th>Factor</th><th>Points</th><th>Detail</th></tr>
    {% for f in a.factors %}<tr><td>{{ f.factor }}</td><td>{{ f.points }}</td><td>{{ f.detail }}</td></tr>{% endfor %}
  </table>
</div>
{% endfor %}
{% if evidence %}
<h3>Case evidence</h3>
<table>
  <tr><th>Title</th><th>Source</th><th>Collected / recorded</th><th>Status</th><th>Integrity</th></tr>
  {% for e in evidence %}
  <tr>
    <td>{{ e.title }}{% if e.excerpt %}<br><span class="muted">{{ e.excerpt }}</span>{% endif %}</td>
    <td>{{ e.source_name }}{% if e.source_url %}<br><code>{{ e.source_url }}</code>{% endif %}</td>
    <td>{% if e.collected_at %}{{ e.collected_at.strftime('%Y-%m-%d %H:%M UTC') }} (collected)<br>{% endif %}{{ e.retrieved_at.strftime('%Y-%m-%d %H:%M UTC') }} (recorded)</td>
    <td>{{ e.verification }}</td>
    <td>{% if e.sha256 %}SHA-256<br><code>{{ e.sha256 }}</code>{% else %}—{% endif %}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}
{% endif %}

<h2>{{ '6' if kind == 'technical' else '4' }}. Confirmed facts, potential impact and unknowns</h2>
{% for a in assessments %}
<div class="block">
  <h3>{{ a.advisory }} — {{ a.vendor }} {{ a.product }}</h3>
  <strong>Known</strong><ul>{% for k in a.known %}<li>{{ k }}</li>{% endfor %}</ul>
  <strong>Not established / unknown</strong><ul>{% for u in a.unknowns %}<li>{{ u }}</li>{% endfor %}</ul>
</div>
{% else %}<p class="muted">None.</p>{% endfor %}

<h2>{{ '7' if kind == 'technical' else '5' }}. Actions completed and remaining remediation</h2>
{% if tasks %}
<table>
  <tr><th>Task</th><th>Status</th><th>Due</th><th>Outcome (claimed)</th><th>Verification</th></tr>
  {% for t in tasks %}<tr><td>{{ t.title }}</td><td>{{ t.status }}</td><td>{{ t.due_date or '—' }}</td><td>{{ t.completion_notes or '—' }}</td><td>{{ t.verification }}{% if t.verified_at %} · {{ t.verified_at.strftime('%Y-%m-%d') }}{% endif %}{% if t.verification_notes %}<br><span class="muted">{{ t.verification_notes }}</span>{% endif %}</td></tr>{% endfor %}
</table>
{% else %}<p class="muted">No remediation tasks recorded.</p>{% endif %}
{% for a in assessments %}{% if a.steps and kind == 'technical' %}
<div class="block"><strong>Recommended verification ({{ a.advisory }})</strong><ul>{% for s in a.steps %}<li>{{ s }}</li>{% endfor %}</ul></div>
{% endif %}{% endfor %}

{% if notes %}
<h2>Updates for the client</h2>
{% for n in notes %}<div class="note"><span class="muted">{{ n.created_at.strftime('%Y-%m-%d %H:%M UTC') }}</span><br>{{ n.body }}</div>{% endfor %}
{% endif %}

{% if kind == 'technical' %}
<h2>8. Timeline</h2>
<table>
  <tr><th>Time (UTC)</th><th>Source</th><th>Event</th></tr>
  {% for e in timeline %}<tr><td>{{ e.occurred_at.strftime('%Y-%m-%d %H:%M') }}</td><td>{{ 'System' if e.system else 'Analyst' }}</td><td>{{ e.summary }}</td></tr>{% endfor %}
</table>
{% if timeline_truncated %}<p class="muted">Timeline truncated to the most recent report limit.</p>{% endif %}
{% endif %}

<h2>Outstanding risks and open questions</h2>
<ul>
  {% for a in assessments %}{% for u in a.unknowns %}<li><strong>{{ a.advisory }}</strong>: {{ u }}</li>{% endfor %}{% endfor %}
  {% if tasks_open %}<li>{{ tasks_open }} remediation task(s) are still open.</li>{% endif %}
  {% if tasks_unverified_done %}<li>{{ tasks_unverified_done }} completed task(s) await verification.</li>{% endif %}
  {% if not assessments and not tasks_open and not tasks_unverified_done %}<li>None recorded.</li>{% endif %}
</ul>

<h2>Scope and methodology</h2>
<p>Findings are produced by deterministic matching of advisories (NVD, CISA KEV, or as named above) against the client's recorded inventory and dependency relationships. The engine states only <em>potential impact</em> or <em>insufficient data</em>; verified exposure, confirmed dependency and confirmed compromise are recorded by analysts with evidence. Evidence integrity is shown as SHA-256 digests taken when files were stored; a digest shows a file is unchanged since hashing, not that it was authentic when collected. Veylith coordinates and records remediation; it makes no changes to customer systems.</p>

<h2>Limitations</h2>
<ul>
  <li>This report reflects the vendor, product and relationship inventory as recorded at {{ generated_at.strftime('%Y-%m-%d %H:%M UTC') }}. An incomplete inventory can hide real exposure; "no match" never proves safety.</li>
  <li>A vulnerability or advisory match is not evidence of compromise. States above reflect what is verified, not what is assumed.</li>
  <li>Advisory data comes from the sources named above and may be revised after publication.</li>
  {% if truncated %}<li>This report was truncated to the configured size limit.</li>{% endif %}
</ul>
<p class="muted">Generated by Veylith for {{ organization }}. Report {{ reference }}.</p>
</body>
</html>
