# Copy to .env and change every secret. .env is excluded from Git.
POSTGRES_USER=veylith
POSTGRES_PASSWORD=change-me-owner-password
POSTGRES_DB=veylith
# Password of the restricted runtime role (cannot bypass row-level security)
APP_DB_PASSWORD=change-me-app-password

# Long random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

ENVIRONMENT=development
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
TRUSTED_ORIGINS=http://localhost:3000

# Optional: raises the NVD rate limit. Never commit a real key.
NVD_API_KEY=

# --- Demo / seed login credentials (synthetic data only; choose your own password) ---
DEMO_PASSWORD=
DEMO_OWNER_EMAIL=demo.owner@example.com
DEMO_ANALYST_EMAIL=demo.analyst@example.com
DEMO_VIEWER_EMAIL=demo.viewer@example.com
